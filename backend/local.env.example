# Optional overrides for local/NAS operation. Never commit the populated file.
APP_MODE=local
STORAGE_BACKEND=sqlite
MODEL_BACKEND=deterministic
AUTH_BACKEND=environment
LOCAL_DB_PATH=./runtime/recsbot.db
RECSBOT_AUTH_TOKEN=
USER_ID=default-user

# Set MODEL_BACKEND=ollama to use a locally reachable Ollama server.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
