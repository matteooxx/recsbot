# recsbot-ui environment template. Keep the populated copy outside Git with
# mode 0600. For Compose, use runtime/app.env.

# Auth
ADMIN_USER=admin
ADMIN_PASS_HASH=
SECRET_KEY=
SESSION_INACTIVITY_HOURS=3

# Email (forgot-password), optional. Use a dedicated account with an
# app-specific password rather than reusing credentials from another service.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OWNER_EMAIL=

# Backend. Use http://127.0.0.1:8000 outside Docker. The Compose default below
# reaches a backend published on the same host.
RECSBOT_BASE_URL=http://host.docker.internal:8000
RECSBOT_BEARER_TOKEN=
RECSBOT_TLS_VERIFY=true

# Steam (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=
STEAM_ID=

# Jellyfin (Settings → API Keys → New)
JELLYFIN_BASE_URL=http://127.0.0.1:8096
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=
